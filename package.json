{
  "name": "badminton-p0a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/gateway/src/index.ts",
    "dev:web": "npm run dev --workspace @badminton/web",
    "build": "tsc --noEmit && npm run build --workspace @badminton/web",
    "test": "tsx --test packages/*/test/*.test.ts apps/gateway/test/*.test.ts",
    "test:worker": "node scripts/test-python.mjs tests/worker",
    "test:pose3d-evaluation": "node scripts/test-python.mjs tests/pose3d",
    "check": "npm run build && npm test",
    "start": "tsx apps/gateway/src/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
